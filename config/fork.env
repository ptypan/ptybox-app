# =============================================================================
# PtyBox - Configuracion master del fork
# Fuente unica de verdad. Todos los scripts y workflows leen de aqui.
# =============================================================================

# --- Identidad de la aplicacion ---------------------------------------------
# CRITICO: PTYBOX_PKG debe medir EXACTAMENTE 10 caracteres (igual que
# "com.termux"). Los binarios del bootstrap de Termux llevan horneada la cadena
# "/data/data/com.termux/files/usr" (31 bytes) y solo parcheamos sustituyendo
# bytes 1:1. Si el paquete cambia de longitud, el parche es imposible.
PTYBOX_PKG="com.ptybox"
PTYBOX_APP_NAME="PtyBox"
PTYBOX_API_PKG="com.ptybox.api"
PTYBOX_API_APP_NAME="PtyBox:API"

# Longitudes, validadas por scripts/check_invariants.sh
PTYBOX_PREFIX="/data/data/${PTYBOX_PKG}/files/usr"
UPSTREAM_PKG="com.termux"
UPSTREAM_PREFIX="/data/data/${UPSTREAM_PKG}/files/usr"

# --- Upstream ----------------------------------------------------------------
UPSTREAM_APP_REPO="termux/termux-app"
UPSTREAM_API_REPO="termux/termux-api"
UPSTREAM_COMMIT="8629e632fcb95da272221be327db653fb24befe9"
UPSTREAM_APP_VERSION="0.118.0"
UPSTREAM_BOOTSTRAP_VERSION="2026.02.12-r1"
PTYBOX_PACKAGE_VARIANT="apt-android-7"

# Checksums oficiales del bootstrap (termux-packages release)
# Se usan para verificar la descarga ANTES de parchear.
BOOTSTRAP_SHA256_aarch64="ea2aeba8819e517db711f8c32369e89e7c52cee73e07930ff91185e1ab93f4f3"
BOOTSTRAP_SHA256_arm="a38f4d3b2f735f83be2bf54eff463e86dc32a3e2f9f861c1557c4378d249c018"
BOOTSTRAP_SHA256_i686="f5bc0b025b9f3b420b5fcaeefc064f888f5f22a0d6fd7090f4aac0c33eb3555b"
BOOTSTRAP_SHA256_x86_64="b7fd0f2e3a4de534be3144f9f91acc768630fc463eaf134ab2e64c545e834f7a"

BOOTSTRAP_RELEASE_URL="https://github.com/termux/termux-packages/releases/download/bootstrap-${UPSTREAM_BOOTSTRAP_VERSION}%2B${PTYBOX_PACKAGE_VARIANT}/bootstrap"

# --- Version de nuestro fork -------------------------------------------------
PTYBOX_VERSION_CODE="1180"
PTYBOX_VERSION_NAME="0.118.0-ptybox1"

# --- GitHub ------------------------------------------------------------------
GITHUB_USER="ptypan"
PTYBOX_APP_REPO="ptybox-app"
PTYBOX_API_REPO="ptybox-api"
GITHUB_BRANCH="master"
PTYBOX_APP_REPO_URL="https://github.com/${GITHUB_USER}/${PTYBOX_APP_REPO}"
PTYBOX_API_REPO_URL="https://github.com/${GITHUB_USER}/${PTYBOX_API_REPO}"
PTYBOX_APP_REPO_SSH="git@github.com:${GITHUB_USER}/${PTYBOX_APP_REPO}.git"
PTYBOX_API_REPO_SSH="git@github.com:${GITHUB_USER}/${PTYBOX_API_REPO}.git"

# --- Rutas locales ------------------------------------------------------------
WORKSPACE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"